# Copie este archivo como .env y complete los valores. El .env nunca se sube al repositorio.

# Clave para firmar la sesión de Flask (cadena larga y aleatoria).
SECRET_KEY=CAMBIAR

# Base de datos PostgreSQL (Docker Compose crea la base con estos datos)
DB_USER=CAMBIAR
DB_PASSWORD=CAMBIAR
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lhpulse

# Puerto local de la API en Docker (http://127.0.0.1:5075)
API_PUERTO=5075

# Administrador de ejemplo que crea "flask --app run sembrar" (solo si la base está vacía)
SEMILLA_ADMIN_CORREO=admin@lhpulse.test
SEMILLA_ADMIN_CLAVE=CAMBIAR

# Módulo de metas (Sprint 2)
# Origen de los datos: sqlalchemy (PostgreSQL) o memoria (pruebas)
METAS_ORIGEN_DATOS=sqlalchemy
# Semáforo: proporcional (meta al día de corte) o mensual (meta completa)
METAS_SEMAFORO=proporcional
METAS_UMBRAL_VERDE=1.0
METAS_UMBRAL_AMARILLO=0.9
METAS_CACHE_TIENDAS_SEGUNDOS=60

# APIs externas (opcionales)
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=

# Correos con permisos especiales (separados por coma)
CUADRANTE_EMAIL_PERMITIDO=
CORREOS_SUPERVISORAS=
NOVEDADES_EDITORES=
NOVEDADES_LECTORES=
SIN_ADMINISTRACION=
CIERRES_TIENDA_ADMIN=
PLANILLA_HORARIOS=

# Mensajes de depuración (1 para activarlos)
LH_DEBUG=
